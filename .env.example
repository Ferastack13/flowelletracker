# Public Supabase credentials (safe for the browser).
# Copy this file to .env.local and replace the placeholders.
# Never put the service-role key in NEXT_PUBLIC_* variables or client code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only Supabase service role (cron + reminder scheduling).
# Never expose this in the browser or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Protects /api/cron/notifications. Vercel sends this as Authorization: Bearer …
CRON_SECRET=generate_a_long_random_string

# Resend transactional email (server-only).
# Create an API key and verify a sending domain in Resend before production delivery.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Flowelle <reminders@your-verified-domain.com>
